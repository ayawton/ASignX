# Backend only. Obtain a fresh connection string from Supabase Connect.
# Use direct or session-pooler mode for migrations. Percent-encode the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
RECOGNITION_URL=http://127.0.0.1:8001
RECOGNITION_INTERNAL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
RECOGNITION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For a private Railway recognition container: RECOGNITION_HOST=::, PORT=8001.
# Set these on Python only; the API uses its own Railway-provided PORT.
# RECOGNITION_HOST=127.0.0.1
# Optional local interpreter; do not copy a Windows path to Railway.
# RECOGNITION_PYTHON=python3
# Only set after verifying actual proxy IP/CIDR ranges and header handling.
# No wildcard, boolean, or hop-count trust. Empty means forwarded IPs untrusted.
TRUST_PROXY_CIDRS=

# Production always verifies database TLS. Get the public CA from Supabase Database Settings.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nPASTE_PUBLIC_CA_PEM\n-----END CERTIFICATE-----"
